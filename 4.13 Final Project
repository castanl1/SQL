SELECT * FROM chinook.customers;

-- 1. Show Customers (their full names, customer ID, and country) who are not in the US. 
SELECT chinook.customers.FirstName, chinook.customers.LastName, chinook.customers.CustomerId, chinook.customers.Country
FROM chinook.customers
WHERE Country != 'USA'
;

-- 2. Show only the Customers from Brazil.
SELECT *
FROM chinook.customers
WHERE Country = 'Brazil'
;

-- 3. Find the Invoices of customers who are from Brazil. The resulting table should show the customer's full name, Invoice ID, Date of the invoice, and billing country.
SELECT chinook.customers.FirstName, chinook.customers.LastName, chinook.invoices.InvoiceId, chinook.invoices.InvoiceDate, chinook.invoices.BillingCountry
FROM chinook.customers
LEFT JOIN chinook.invoices
ON chinook.customers.CustomerId = chinook.invoices.CustomerId
WHERE chinook.customers.Country = 'Brazil'
;

-- 4. Show the Employees who are Sales Agents.
SELECT *
FROM chinook.employees
WHERE Title = 'Sales Support Agent'
;

-- 5. Find a unique/distinct list of billing countries from the Invoice table.
SELECT DISTINCT chinook.invoices.BillingCountry
FROM chinook.invoices
;

-- 6. Provide a query that shows the invoices associated with each sales agent. The resulting table should include the Sales Agent's full name.
SELECT chinook.employees.FirstName, chinook.employees.LastName, chinook.invoices.InvoiceId
FROM chinook.employees
JOIN chinook.customers
ON chinook.employees.EmployeeId = chinook.customers.SupportRepId
JOIN chinook.invoices
ON chinook.invoices.CustomerId = chinook.customers.CustomerId
;

-- 7. Show the Invoice Total, Customer name, Country, and Sales Agent name for all invoices and customers.
Select chinook.invoices.Total, chinook.customers.FirstName, chinook.customers.LastName, chinook.customers.Country, chinook.employees.FirstName, chinook.employees.LastName
FROM chinook.invoices
JOIN chinook.customers
ON chinook.invoices.CustomerId = chinook.customers.CustomerId
JOIN chinook.employees
ON chinook.customers.SupportRepId = chinook.employees.EmployeeId
;

-- 8. How many Invoices were there in 2009?
SELECT COUNT(InvoiceId)
FROM chinook.invoices
WHERE InvoiceDate LIKE '%2009%'
;

-- 9. What are the total sales for 2009?
SELECT SUM(Total)
FROM chinook.invoices
WHERE InvoiceDate LIKE '%2009%'
;

-- 10. Write a query that includes the purchased track name with each invoice line ID.
SELECT chinook.invoice_items.InvoiceLineId, chinook.tracks.Name 
FROM chinook.invoice_items
JOIN chinook.tracks 
ON chinook.invoice_items.TrackId = chinook.tracks.TrackId
;

-- 11. Write a query that includes the purchased track name AND artist name with each invoice line ID.
SELECT chinook.invoice_items.InvoiceLineId, chinook.tracks.Name AS track, chinook.artists.Name AS artist
FROM chinook.invoice_items
JOIN chinook.tracks 
ON chinook.invoice_items.TrackId = chinook.tracks.TrackId
JOIN chinook.albums
ON chinook.tracks.AlbumId = chinook.albums.AlbumId
JOIN chinook.artists
ON chinook.artists.ArtistId = chinook.albums.ArtistId
;

-- 12. Provide a query that shows all the Tracks, and include the Album name, Media type, and Genre.
SELECT chinook.tracks.Name AS track, chinook.albums.Title AS album, chinook.media_types.Name AS media_type, chinook.genres.Name AS genre
FROM chinook.tracks
JOIN chinook.albums
ON chinook.tracks.AlbumId = chinook.albums.AlbumId
JOIN chinook.media_types
ON chinook.tracks.MediaTypeId = chinook.media_types.MediaTypeId
JOIN chinook.genres
ON chinook.tracks.GenreId = chinook.genres.GenreId
;

-- 13. Show the total sales made by each sales agent.
SELECT chinook.employees.FirstName, chinook.employees.LastName, SUM(chinook.invoices.Total) AS 'Total Sales'
FROM chinook.employees
JOIN chinook.customers
ON chinook.customers.SupportRepId = chinook.employees.EmployeeId
JOIN chinook.invoices
ON chinook.invoices.CustomerId = chinook.customers.CustomerId
WHERE chinook.employees.Title = 'Sales Support Agent'
GROUP BY chinook.employees.FirstName
;

-- 14. Which sales agent made the most dollars in sales in 2009?
SELECT chinook.employees.FirstName, chinook.employees.LastName, SUM(chinook.invoices.Total) AS 'Total Sales'
FROM chinook.employees
JOIN chinook.customers
ON chinook.customers.SupportRepId = chinook.employees.EmployeeId
JOIN chinook.invoices
ON chinook.invoices.CustomerId = chinook.customers.CustomerId
WHERE chinook.employees.Title = 'Sales Support Agent'
AND chinook.invoices.InvoiceDate LIKE '%2009%'
GROUP BY chinook.employees.FirstName
ORDER BY SUM(chinook.invoices.Total) DESC
LIMIT 1
;

-------------additional questions

--15. Show the total number of tracks per genre.
SELECT chinook.genres.Name AS 'Genre', COUNT(chinook.tracks.GenreId) AS 'Total Tracks'
FROM chinook.genres
JOIN chinook.tracks
ON chinook.tracks.GenreId = chinook.genres.GenreId
GROUP BY chinook.genres.Name
;

--16. Show all the tracks name in the brazilian music playlist, include the artist name for each track.
SELECT chinook.tracks.Name AS 'Track', chinook.artists.Name AS 'Artist'
FROM chinook.tracks
JOIN chinook.playlist_track
ON chinook.tracks.TrackId = chinook.playlist_track.TrackId
JOIN chinook.playlists
ON chinook.playlists.PlaylistId = chinook.playlist_track.PlaylistId
JOIN chinook.albums
ON chinook.albums.AlbumId = chinook.tracks.AlbumId
JOIN chinook.artists
ON chinook.artists.ArtistId = chinook.albums.ArtistId
WHERE chinook.playlists.Name = 'Brazilian Music'
;

--17. What tracks were purchased for the customer with the highest invoice total, include price for each track.
SELECT chinook.tracks.Name AS 'track', chinook.invoice_items.UnitPrice AS 'price'
FROM chinook.invoices
JOIN chinook.invoice_items
ON chinook.invoices.InvoiceId = chinook.invoice_items.InvoiceId
JOIN chinook.tracks 
ON chinook.tracks.TrackId = chinook.invoice_items.TrackId
WHERE chinook.invoices.Total = (SELECT chinook.invoices.Total FROM chinook.invoices ORDER BY chinook.invoices.Total DESC LIMIT 1)
;
